{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client", "unplugin-icons/types/vue"]
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": ["node_modules", ".vite", "out"]
}
