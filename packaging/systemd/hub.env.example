# /etc/vuesp-hub/hub.env — environment for vuesp-hub.service
# systemd EnvironmentFile format: KEY=VALUE, no shell expansion, no quotes.
# Restart the service after editing: systemctl restart vuesp-hub

# Bind address. Keep loopback until LAN authentication exists.
VUESP_HOST=127.0.0.1
VUESP_PORT=3005

# Database, settings, JWT secret and credential salt live here.
VUESP_DATA_DIR=/var/lib/vuesp-hub

# Master key for device credentials (AES-256-GCM). The key is never written to
# disk; only a random salt is stored. Generate one with:
#   openssl rand -hex 32
# Empty value means the hub starts, but saving/reading device credentials is
# refused with an explicit error.
VUESP_SECRET_KEY=
